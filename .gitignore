# ---- Secrets: NEVER commit these ----
.env
.env.*
*.jks
*.keystore
key.properties
**/key.properties
supabase/.env
supabase/.temp/
*.p12
*.mobileprovision
*.p8
*.pem
*service-account*.json
*-credentials.json
google-services.json
GoogleService-Info.plist
# Codemagic tokens and store credentials (CLAUDE.md section 9): keep them in
# Codemagic's encrypted environment variables, never in files in the repo.
codemagic.env
*.codemagic.env
.codemagic/
*play*key*.json
*play*credential*.json
*api_key*.txt
*api-key*.txt

# ---- Flutter / Dart ----
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
**/generated_plugin_registrant.*
pubspec.lock.bak

# ---- Android ----
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
**/gradle-wrapper.jar

# ---- iOS ----
ios/Pods/
ios/.symlinks/
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/flutter_export_environment.sh

# ---- Flutter golden tests ----
# matchesGoldenFile writes before/after/diff images here on a failing
# comparison, for local inspection -- never committed. The baseline images
# under test/goldens/ ARE committed (they're the regression reference).
test/failures/

# ---- IDE / OS ----
.idea/
*.iml
.vscode/*.local.json
.DS_Store
Thumbs.db

# ---- AI voice detection evaluation (data/voice_eval) ----
# No voice recording, generated speech, model weight or virtual environment is ever committed.
data/voice_eval/audio/
data/voice_eval/models/
data/voice_eval/.venv*/
data/voice_eval/**/*.wav
data/voice_eval/**/*.m4a
data/voice_eval/**/*.aac
data/voice_eval/**/*.mp3
data/voice_eval/**/*.ogg
data/voice_eval/**/*.opus
data/voice_eval/**/*.flac
data/voice_eval/**/*.webm
data/voice_eval/**/*.amr
data/voice_eval/**/*.3gp
data/voice_eval/**/*.caf
data/voice_eval/**/*.mp4
data/voice_eval/**/*.onnx
data/voice_eval/**/*.safetensors

# cached FLEURS metadata (TSV transcripts only, re-downloadable and hash-checked by the script)
data/voice_eval/cache/

__pycache__/
*.pyc
